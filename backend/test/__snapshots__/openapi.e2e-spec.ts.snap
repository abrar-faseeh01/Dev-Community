    "/posts": {
      "get": {
        "description": "Public — no authentication required. Sorted newest-first by _id. Soft-deleted posts are excluded. When the request carries a valid session cookie, each post's \`myReaction\` is the caller's own reaction to it (looked up for the whole page in one query); otherwise it is null.",
        "operationId": "PostsController_list",
        "parameters": [
          {
            "description": "Page size.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 10,
              "maximum": 50,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "description": "Previous response's nextCursor. Omit for the first page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "example": "NmFhZDA2YjQ0OWUyYzRlMDM0ZGE5ZTAx",
              "type": "string",
            },
          },
          {
            "description": "Only posts written by this user (a valid user id). Used for the "posts made by you" page.",
            "in": "query",
            "name": "authorId",
            "required": false,
            "schema": {
              "example": "64f1c2e5a1b2c3d4e5f6a7b8",
              "type": "string",
            },
          },
          {
            "description": "Feed ordering: 'latest' (default), 'top' (ranked score) or 'discussed' (most comments). A cursor is only valid for the sort that produced it.",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "enum": [
                "latest",
                "top",
                "discussed",
              ],
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostListResponseDto",
                },
              },
            },
            "description": "Requesting past the last page returns { items: [], nextCursor: null } rather than an error.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Malformed cursor (bad encoding or not a valid post id), or a malformed authorId.",
          },
        },
        "summary": "List posts (cursor-paginated feed)",
        "tags": [
          "posts",
        ],
      },
      "post": {
        "description": "Regular (\`user\`-role) accounts only. The author is always the authenticated caller — never client-supplied. Administrators get 403: they can moderate any post but cannot create one.",
        "operationId": "PostsController_create",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePostDto",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostResponseDto",
                },
              },
            },
            "description": "",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Missing, invalid, or expired session cookie.",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Administrator accounts cannot create posts (role check: only the \`user\` role may). Admins can still edit or delete any post.",
          },
        },
        "security": [
          {
            "access_token": [],
          },
        ],
        "summary": "Create a post",
        "tags": [
          "posts",
        ],
      },
    },
    "/posts/search": {
      "get": {
        "description": "Public — no authentication required. Matches whole words (stemmed) in title and body, best matches first; a title match outranks a body match. Returns at most \`limit\` results with no next page: \`hasMore\` says whether more matched. Zero matches is a normal 200 with an empty list. Soft-deleted posts are excluded. When the request carries a valid session cookie, each post's \`myReaction\` is the caller's own reaction; otherwise null. \`rankScore\` is always null here.",
        "operationId": "PostsController_search",
        "parameters": [
          {
            "description": "Words to search for. Trimmed; 1-100 characters.",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string",
            },
          },
          {
            "description": "How many results to return at most.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 10,
              "maximum": 20,
              "minimum": 1,
              "type": "integer",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostSearchResponseDto",
                },
              },
            },
            "description": "Zero matches returns { items: [], hasMore: false } rather than an error.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Missing, blank or whitespace-only \`q\`; \`q\` longer than 100 characters; \`limit\` outside 1-20 (rejected, not clamped); or any other query parameter.",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "More than 40 search requests in a minute from one IP.",
          },
        },
        "summary": "Full-text search over posts",
        "tags": [
          "posts",
        ],
      },
    },
    "/posts/{id}": {
      "delete": {
        "description": "Owner-or-admin. Sets deletedAt rather than removing the document — the post then 404s on every read route and never appears in the list. Its comments are soft-deleted along with it (their replies included), so they stop appearing in reads too. When an admin deletes someone else's post, it is audit-logged and the author is notified.",
        "operationId": "PostsController_remove",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "64f1c2e5a1b2c3d4e5f6a7c0",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReasonDto",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeletePostResponseDto",
                },
              },
            },
            "description": "",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Missing, invalid, or expired session cookie.",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Caller is neither the post's author nor an admin.",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Post not found (or already soft-deleted).",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "The post was modified concurrently by someone else (optimistic concurrency). Reload and retry.",
          },
        },
        "security": [
          {
            "access_token": [],
          },
        ],
        "summary": "Delete a post (soft delete)",
        "tags": [
          "posts",
        ],
      },
      "get": {
        "description": "Public — no authentication required. A soft-deleted post 404s the same as a nonexistent one. When the request carries a valid session cookie, \`myReaction\` is the caller's own reaction to the post; otherwise it is null.",
        "operationId": "PostsController_findById",
        "parameters": [
          {
            "in": "path",
            "name": "id",
