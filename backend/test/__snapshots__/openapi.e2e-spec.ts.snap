      "ReactionResultDto": {
        "properties": {
          "dislikeCount": {
            "description": "The target's dislike count after this request.",
            "example": 1,
            "type": "number",
          },
          "likeCount": {
            "description": "The target's like count after this request.",
            "example": 4,
            "type": "number",
          },
          "myReaction": {
            "description": "The caller's own reaction after this request: the type they asked for after a create or a switch, null after a remove.",
            "enum": [
              "like",
              "dislike",
            ],
            "example": "like",
            "nullable": true,
            "type": "string",
          },
        },
        "required": [
