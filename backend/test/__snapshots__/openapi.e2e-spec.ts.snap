          },
          "success": {
            "example": true,
            "type": "boolean",
          },
        },
        "required": [
          "success",
          "data",
        ],
        "type": "object",
      },
      "UpdateBioDto": {
        "properties": {
          "bio": {
            "example": "I build backend systems and enjoy mentoring junior engineers.",
            "maxLength": 1000,
            "type": "string",
          },
          "reason": {
            "description": "Recorded on the audit log entry when an admin edits someone else's profile.",
