            "example": true,
            "type": "boolean",
          },
        },
        "required": [
          "success",
          "data",
        ],
        "type": "object",
      },
      "PostSearchDataDto": {
        "properties": {
          "hasMore": {
            "description": "true when more posts matched than were returned. There is no next page to fetch: refine the search instead.",
            "example": false,
            "type": "boolean",
          },
          "items": {
            "description": "Best matches first (highest text relevance; newest first among equal scores).",
            "items": {
              "$ref": "#/components/schemas/PostDto",
            },
            "type": "array",
          },
        },
        "required": [
          "items",
          "hasMore",
        ],
        "type": "object",
      },
      "PostSearchResponseDto": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PostSearchDataDto",
          },
          "success": {
            "example": true,
            "type": "boolean",
          },
        },
        "required": [
          "success",
          "data",
        ],
        "type": "object",
      },
      "PostSummaryDto": {
        "properties": {
          "source": {
            "description": "Which summarizer produced this. 'mock' is the deterministic extractive fallback (first sentences plus keyword tags), not a model-written summary.",
            "enum": [
              "mock",
              "gemini",
            ],
            "example": "gemini",
            "type": "string",
          },
          "summary": {
            "example": "The author explains why they moved from offset to cursor pagination and what it changed.",
            "maxLength": 600,
            "type": "string",
          },
          "tags": {
            "description": "Skill or technology tags, each up to 30 characters. Plain text: render it as text, never as markup.",
            "example": [
              "pagination",
              "MongoDB",
            ],
            "items": {
              "type": "string",
            },
            "maxItems": 5,
            "minItems": 1,
            "type": "array",
          },
          "truncated": {
            "description": "true when the post was longer than 8000 characters and only the first part was summarized.",
            "example": false,
            "type": "boolean",
          },
        },
        "required": [
          "summary",
          "tags",
          "source",
          "truncated",
        ],
        "type": "object",
      },
      "PostSummaryResponseDto": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PostSummaryDto",
          },
          "success": {
            "example": true,
            "type": "boolean",
          },
        },
        "required": [
          "success",
          "data",
        ],
        "type": "object",
      },
