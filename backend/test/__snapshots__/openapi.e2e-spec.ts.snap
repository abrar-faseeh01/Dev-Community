        },
        "required": [
          "bio",
        ],
        "type": "object",
      },
      "UpdateCommentDto": {
        "properties": {
          "body": {
            "description": "The comment's new body. Trimmed before validation, so a whitespace-only value is rejected the same as an empty one, the same rule as on create.",
            "example": "The cursor approach also keeps the page stable while new posts arrive — edited for clarity.",
            "maxLength": 2000,
            "type": "string",
          },
        },
        "required": [
          "body",
        ],
        "type": "object",
      },
      "UpdateCredentialsDto": {
        "properties": {
          "currentPassword": {
            "description": "Required to change any credential, even just the name.",
            "example": "correct-horse-battery-staple",
            "type": "string",
          },
          "newEmail": {
            "example": "ada.new@example.com",
            "type": "string",
          },
          "newFullName": {
            "example": "Ada K. Lovelace",
            "minLength": 2,
            "type": "string",
          },
          "newPassword": {
            "example": "new-correct-horse-battery",
            "minLength": 8,
            "type": "string",
          },
        },
        "required": [
          "currentPassword",
        ],
        "type": "object",
      },
      "UpdateExperienceDto": {
        "properties": {
          "company": {
            "example": "Acme Corp",
            "type": "string",
          },
          "description": {
            "example": "Promoted; led the payments team.",
            "type": "string",
          },
          "from": {
            "description": "Free text, not a parsed date.",
            "example": "2021",
            "type": "string",
          },
          "reason": {
            "description": "Recorded on the audit log entry when an admin edits someone else's profile.",
            "example": "corrected job title",
            "type": "string",
          },
          "title": {
            "example": "Senior Software Engineer",
            "type": "string",
          },
          "to": {
            "example": "2023",
            "type": "string",
          },
        },
        "type": "object",
      },
      "UpdateHeadlineDto": {
        "properties": {
          "headline": {
            "example": "Senior Backend Engineer @ Acme",
            "maxLength": 120,
            "type": "string",
          },
          "reason": {
            "description": "Recorded on the audit log entry when an admin edits someone else's profile.",
            "example": "corrected outdated title",
            "type": "string",
          },
        },
        "required": [
          "headline",
        ],
        "type": "object",
      },
      "UpdatePortfolioProjectsDto": {
        "properties": {
          "portfolioProjects": {
            "description": "Full replacement of the portfolio projects list.",
            "items": {
              "$ref": "#/components/schemas/PortfolioProjectDto",
            },
            "maxItems": 20,
            "type": "array",
          },
          "reason": {
            "description": "Recorded on the audit log entry when an admin edits someone else's profile.",
            "example": "removed a project that violated content policy",
            "type": "string",
          },
        },
        "required": [
          "portfolioProjects",
        ],
        "type": "object",
      },
      "UpdatePostDto": {
        "properties": {
          "body": {
            "example": "Updated with benchmark numbers from production.",
            "maxLength": 20000,
            "type": "string",
          },
          "reason": {
            "description": "Recorded on the audit log entry when an admin edits someone else's post.",
            "example": "contains a policy violation",
            "type": "string",
          },
          "title": {
            "description": "At least one of title or body is required.",
            "example": "Why we switched to cursor pagination (updated)",
            "maxLength": 200,
            "type": "string",
          },
        },
        "type": "object",
      },
      "UpdateProfileDto": {
        "properties": {
          "bio": {
            "example": "I build backend systems and enjoy mentoring junior engineers.",
            "maxLength": 1000,
            "type": "string",
          },
          "headline": {
            "example": "Senior Backend Engineer @ Acme",
            "maxLength": 120,
            "type": "string",
          },
          "portfolioProjects": {
            "items": {
              "$ref": "#/components/schemas/PortfolioProjectDto",
            },
            "maxItems": 20,
            "type": "array",
          },
          "skills": {
            "example": [
              "typescript",
              "nestjs",
              "mongodb",
            ],
            "items": {
              "type": "string",
            },
            "maxItems": 50,
            "type": "array",
          },
        },
        "type": "object",
      },
      "UpdateSkillsDto": {
        "properties": {
          "reason": {
            "description": "Recorded on the audit log entry when an admin edits someone else's profile.",
            "example": "added missing skills at user's request",
            "type": "string",
          },
          "skills": {
            "description": "Full replacement of the skills list — an empty array clears it.",
            "example": [
              "typescript",
              "nestjs",
              "mongodb",
            ],
            "items": {
              "type": "string",
            },
            "type": "array",
          },
        },
        "required": [
          "skills",
        ],
        "type": "object",
      },
      "UserListItemDto": {
        "properties": {
          "createdAt": {
            "example": "2026-09-01T10:00:00.000Z",
            "format": "date-time",
            "type": "string",
          },
          "email": {
            "example": "ada@example.com",
            "type": "string",
          },
          "fullName": {
            "example": "Ada Lovelace",
            "type": "string",
          },
          "id": {
            "example": "64f1c2e5a1b2c3d4e5f6a7b8",
            "type": "string",
          },
          "role": {
            "enum": [
              "admin",
              "user",
            ],
            "example": "user",
            "type": "string",
          },
        },
        "required": [
          "id",
          "fullName",
          "email",
          "role",
          "createdAt",
        ],
        "type": "object",
      },
      "UsersListResponseDto": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/UserListItemDto",
            },
            "type": "array",
          },
          "success": {
            "example": true,
            "type": "boolean",
          },
        },
        "required": [
          "success",
          "data",
        ],
        "type": "object",
      },
    },
    "securitySchemes": {
      "access_token": {
        "description": "httpOnly JWT cookie set by POST /auth/login.",
        "in": "cookie",
        "name": "access_token",
        "type": "apiKey",
      },
    },
  },
  "info": {
    "contact": {},
    "description": "API documentation for the Developer Community Platform. Every response follows the shared envelope: {success:true, data} on success or {success:false, statusCode, message, errors} on failure. Auth is an httpOnly \`access_token\` cookie set by POST /auth/login — there is no bearer header. In Swagger UI, use POST /auth/login's Try it out (with \`credentials: 'include'\`-equivalent cookie handling) once, then the cookie is sent automatically by the browser on subsequent Try it out calls for protected routes. The access token is a short-lived JWT (15 minutes by default). Login also sets an httpOnly \`refresh_token\` cookie (7 days by default, sent only to /auth/*); when a protected call returns 401 because the access token expired, call POST /auth/refresh to get a new one. Up to 5 devices can be signed in at once. Request bodies must be JSON (\`Content-Type: application/json\`, otherwise 415) and at most 100kb (otherwise 413). Both come back in the standard failure envelope. Rate-limited routes answer 429 with a \`Retry-After\` header.",
    "title": "Developer Community API",
    "version": "1.0",
  },
  "openapi": "3.0.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "AppController_getHello",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
          },
        },
        "tags": [
          "App",
        ],
      },
    },
    "/admin/audit-log": {
      "get": {
        "description": "Newest first. No filtering or pagination yet — every admin override across users, profiles, and posts is returned.",
        "operationId": "AuditController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditLogListResponseDto",
                },
              },
            },
            "description": "",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Missing, invalid, or expired session cookie.",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Caller is not an admin.",
          },
        },
        "security": [
          {
            "access_token": [],
          },
        ],
        "summary": "List every admin-override audit entry (admin only)",
        "tags": [
          "admin",
        ],
      },
    },
    "/auth/login": {
      "post": {
        "description": "Sets an httpOnly \`access_token\` cookie (a 15-minute JWT) and an httpOnly \`refresh_token\` cookie (valid 7 days, sent only to the auth routes) on success. Up to 5 devices can be signed in at once; a sixth login signs out the oldest. Rate-limited to 5 requests/minute per IP.",
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto",
                },
              },
            },
            "description": "Logged in.",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Invalid email or password.",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Rate limit exceeded.",
          },
        },
        "summary": "Log in",
        "tags": [
          "auth",
        ],
      },
    },
    "/auth/logout": {
      "post": {
        "description": "Clears the \`access_token\` and \`refresh_token\` cookies and revokes the refresh token of this device. Never requires a valid session, so a client can always log itself out.",
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NullDataResponseDto",
                },
              },
            },
            "description": "Logged out.",
          },
        },
        "summary": "Log out",
        "tags": [
          "auth",
        ],
      },
    },
    "/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto",
                },
              },
            },
            "description": "",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Missing, invalid, or expired session cookie.",
          },
        },
        "security": [
          {
            "access_token": [],
          },
        ],
        "summary": "Get the current authenticated user",
        "tags": [
          "auth",
        ],
      },
      "patch": {
        "description": "Requires \`currentPassword\` regardless of which field is changing. Only admins may change \`newEmail\`. Issues fresh \`access_token\` and \`refresh_token\` cookies reflecting the new credentials and signs out every other device. Rate-limited to 10 requests/minute per IP.",
        "operationId": "AuthController_updateMe",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCredentialsDto",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto",
                },
              },
            },
            "description": "Credentials updated.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Wrong currentPassword, or no new field provided.",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "A non-admin tried to change newEmail.",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "newEmail already in use, or a concurrent update.",
          },
        },
        "security": [
          {
            "access_token": [],
          },
        ],
        "summary": "Update your own name, email, and/or password",
        "tags": [
          "auth",
        ],
      },
    },
    "/auth/refresh": {
      "post": {
        "description": "Authenticated by the httpOnly \`refresh_token\` cookie, because the \`access_token\` is expired by the time this is called. The refresh token is not rotated. Rate-limited to 20 requests/minute per IP.",
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto",
                },
              },
            },
            "description": "A new \`access_token\` cookie was issued.",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Refresh cookie missing, malformed, expired, or revoked (logged out, evicted by a sixth login, or credentials changed). Both cookies are cleared.",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Rate limit exceeded.",
          },
        },
        "summary": "Renew the access token",
        "tags": [
          "auth",
        ],
      },
    },
    "/auth/signup": {
      "post": {
        "description": "Rate-limited to 5 requests/minute per IP.",
        "operationId": "AuthController_signup",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupDto",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto",
                },
              },
            },
            "description": "Account created.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Validation failed (weak password, invalid email, etc.).",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Email already in use.",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Rate limit exceeded.",
          },
        },
        "summary": "Create an account",
        "tags": [
          "auth",
        ],
      },
    },
    "/comments/{id}": {
      "delete": {
        "description": "Sets \`deletedAt\` on the comment and on every reply beneath it in one atomic operation — there is no placeholder left behind; the whole branch stops appearing in reads. Allowed for the comment's author, for the author of the post the comment is on, and for an administrator. \`deletedCount\` in the response is how many comments this call deleted (the comment plus its replies). Decrements the post's \`commentCount\` by that number. When an administrator deletes someone else's comment, the deletion is audit-logged (\`delete_comment\`, with the reason if one is given and how many comments went with it) and the comment's author is notified. A post's author removing a comment on their post is not audit-logged and does not notify anyone.",
        "operationId": "CommentsController_remove",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "64f1c2e5a1b2c3d4e5f6a7c0",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReasonDto",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteCommentResponseDto",
                },
              },
            },
            "description": "",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Malformed comment id.",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Missing, invalid, or expired session cookie.",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "The caller is not the comment's author, not the author of the post it is on, and not an administrator.",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "The comment does not exist, was already deleted, or was deleted by a concurrent request.",
          },
        },
        "security": [
          {
            "access_token": [],
          },
        ],
        "summary": "Delete a comment and its replies (soft delete)",
        "tags": [
          "comments",
        ],
      },
      "patch": {
        "description": "Only the comment's own author may edit it — not an administrator, and not the author of the post it is on (unlike delete, this has no override). Nothing about the comment other than its body ever changes: not its post, not its parent, not who wrote it. \`updatedAt\` in the response is how a client detects an edit (compare it against \`createdAt\`); the value itself is not meant to be shown.",
        "operationId": "CommentsController_update",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "64f1c2e5a1b2c3d4e5f6a7c0",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCommentDto",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditCommentResponseDto",
                },
              },
            },
            "description": "",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Malformed comment id, or a blank, whitespace-only or over-2000-character body.",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Missing, invalid, or expired session cookie.",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "The caller is not the comment's author.",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "The comment does not exist or has been deleted.",
          },
        },
        "security": [
          {
            "access_token": [],
          },
        ],
        "summary": "Edit a comment's body",
        "tags": [
          "comments",
        ],
      },
    },
    "/comments/{id}/reaction": {
      "post": {
        "description": "Regular (\`user\`-role) accounts only. One endpoint for every reaction change, decided by what the caller already has: no reaction → creates it; the same type again → removes it; the opposite type → switches it in place (one counter goes down and the other up). Not idempotent by design — sending the same request twice gives different results (react, then un-react). The response is the target's counters after the change plus the caller's own reaction (\`myReaction\`, null after a remove).",
        "operationId": "ReactionsController_toggleComment",
        "parameters": [
          {
            "description": "The comment id.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "64f1c2e5a1b2c3d4e5f6a7c0",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToggleReactionDto",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReactionResponseDto",
                },
              },
            },
            "description": "",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Malformed comment id, a \`type\` other than \`like\` or \`dislike\`, or an unknown property in the body.",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Missing, invalid, or expired session cookie.",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Administrator accounts cannot react (role check: only the \`user\` role may) — admins moderate, they do not participate.",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "The comment does not exist or has been deleted.",
          },
        },
        "security": [
          {
            "access_token": [],
          },
        ],
        "summary": "Like or dislike a comment (toggle)",
        "tags": [
          "reactions",
        ],
      },
    },
    "/comments/{id}/reactions": {
      "get": {
        "description": "Public — no authentication required, the same as reading the post or comment itself. The most recent reactors first, at most 50, each as \`{ user: { id, fullName, headline }, type }\` (a deleted account is the "Deleted user" placeholder). \`type\` narrows the list to likes or dislikes. \`likeCount\` and \`dislikeCount\` are the target's true totals, unaffected by the filter or the cap.",
        "operationId": "ReactionsController_listCommentReactors",
        "parameters": [
          {
            "description": "The comment id.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "64f1c2e5a1b2c3d4e5f6a7c0",
              "type": "string",
            },
          },
          {
            "description": "Only list people who gave this reaction. Omit for everyone. The counts in the response are unaffected.",
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "enum": [
                "like",
                "dislike",
              ],
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReactorListResponseDto",
                },
              },
            },
            "description": "",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Malformed comment id, a \`type\` other than \`like\` or \`dislike\`, or an unknown query parameter.",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "The comment does not exist or has been deleted.",
          },
        },
        "summary": "Who reacted to a comment",
        "tags": [
          "reactions",
        ],
      },
    },
