          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Post not found (or already soft-deleted).",
          },
        },
        "summary": "Get a single post",
        "tags": [
