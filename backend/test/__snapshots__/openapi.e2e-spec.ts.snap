        ],
        "type": "object",
      },
      "ReactorListDto": {
        "properties": {
          "dislikeCount": {
            "description": "The target's total dislike count. Not affected by \`type\` or by the cap.",
            "example": 2,
            "type": "number",
          },
          "items": {
            "description": "The most recent reactors first, at most 50. Filtered by \`type\` when that is given.",
            "items": {
              "$ref": "#/components/schemas/ReactorDto",
            },
            "type": "array",
          },
          "likeCount": {
            "description": "The target's total like count, the same number shown next to the buttons. Not affected by \`type\` or by the 50 cap.",
            "example": 12,
            "type": "number",
          },
        },
        "required": [
          "items",
          "likeCount",
          "dislikeCount",
        ],
        "type": "object",
      },
