          "data",
        ],
        "type": "object",
      },
      "ReasonDto": {
        "properties": {
          "reason": {
            "description": "Only meaningful when an admin acts on someone else's data — recorded on the audit log entry and appended to the notification sent to the affected user. Ignored on a self-action.",
            "example": "violates community guidelines",
            "type": "string",
          },
        },
        "type": "object",
      },
      "SignupDto": {
        "properties": {
          "email": {
