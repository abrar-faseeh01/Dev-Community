        ],
      },
      "patch": {
        "description": "Owner-or-admin. Partial update — at least one of title/body is required. When an admin edits someone else's post, the change is audit-logged (identifying the post, not just the author) and the author is notified.",
        "operationId": "PostsController_update",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "64f1c2e5a1b2c3d4e5f6a7c0",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePostDto",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostResponseDto",
                },
              },
            },
            "description": "",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Missing, invalid, or expired session cookie.",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Caller is neither the post's author nor an admin.",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Post not found (or already soft-deleted).",
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "The post was modified concurrently by someone else (optimistic concurrency). Reload and retry.",
          },
        },
        "security": [
          {
            "access_token": [],
          },
        ],
        "summary": "Update a post",
        "tags": [
          "posts",
        ],
      },
    },
    "/posts/{id}/reaction": {
      "post": {
        "description": "Regular (\`user\`-role) accounts only. One endpoint for every reaction change, decided by what the caller already has: no reaction → creates it; the same type again → removes it; the opposite type → switches it in place (one counter goes down and the other up). Not idempotent by design — sending the same request twice gives different results (react, then un-react). The response is the target's counters after the change plus the caller's own reaction (\`myReaction\`, null after a remove).",
        "operationId": "ReactionsController_togglePost",
        "parameters": [
          {
            "description": "The post id.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "64f1c2e5a1b2c3d4e5f6a7b9",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToggleReactionDto",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReactionResponseDto",
                },
              },
            },
            "description": "",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Malformed post id, a \`type\` other than \`like\` or \`dislike\`, or an unknown property in the body.",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Missing, invalid, or expired session cookie.",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Administrator accounts cannot react (role check: only the \`user\` role may) — admins moderate, they do not participate.",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "The post does not exist or has been deleted.",
          },
        },
        "security": [
          {
            "access_token": [],
          },
        ],
        "summary": "Like or dislike a post (toggle)",
        "tags": [
          "reactions",
        ],
      },
    },
    "/posts/{id}/reactions": {
      "get": {
        "description": "Public — no authentication required, the same as reading the post or comment itself. The most recent reactors first, at most 50, each as \`{ user: { id, fullName, headline }, type }\` (a deleted account is the "Deleted user" placeholder). \`type\` narrows the list to likes or dislikes. \`likeCount\` and \`dislikeCount\` are the target's true totals, unaffected by the filter or the cap.",
        "operationId": "ReactionsController_listPostReactors",
        "parameters": [
          {
            "description": "The post id.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "64f1c2e5a1b2c3d4e5f6a7b9",
              "type": "string",
            },
          },
          {
            "description": "Only list people who gave this reaction. Omit for everyone. The counts in the response are unaffected.",
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "enum": [
                "like",
                "dislike",
              ],
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReactorListResponseDto",
                },
              },
            },
            "description": "",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Malformed post id, a \`type\` other than \`like\` or \`dislike\`, or an unknown query parameter.",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "The post does not exist or has been deleted.",
          },
        },
        "summary": "Who reacted to a post",
        "tags": [
          "reactions",
        ],
      },
    },
    "/posts/{id}/summarize": {
      "post": {
        "description": "Any signed-in user, administrators included. Only the post's title and body are sent to the summarizer, never the author or the caller. With a model key configured the summary comes from Gemini (\`source: 'gemini'\`); otherwise from a deterministic extractive fallback (\`source: 'mock'\`), which is not real summarization. A body over 8000 characters is cut to its first 8000 and \`truncated\` is true. A body under 200 characters is rejected. Results are not stored: every call is computed fresh. The summary and tags are plain text and must be rendered as text.",
        "operationId": "SummarizerController_summarize",
        "parameters": [
          {
            "description": "The post id.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "64f1c2e5a1b2c3d4e5f6a7c0",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostSummaryResponseDto",
                },
              },
            },
            "description": "",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Malformed post id.",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Missing, invalid, or expired session cookie.",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Post not found (or already soft-deleted).",
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "The post body is under 200 characters, too short to summarize.",
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "More than 10 summarize requests in a minute from one IP.",
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "The summarizer answered with something unusable (not valid JSON, no summary, or no valid tags).",
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "The summarizer is temporarily unavailable (unreachable, rate-limited or daily quota used up). Retrying right away may not help.",
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "The summarizer took too long to respond.",
          },
        },
        "security": [
          {
            "access_token": [],
          },
        ],
        "summary": "Summarize a post (summary text and skill tags)",
        "tags": [
          "posts",
        ],
      },
    },
    "/posts/{postId}/comments": {
      "get": {
        "description": "Public — no authentication required. Returns every live comment on the post as a nested tree: top-level comments newest first, each with its full reply thread in \`replies\` (oldest first), nested up to a maximum depth of 2 — a reply deeper than that still appears in its root's \`replies\`, keeping its own true \`parentCommentId\`, rather than nesting further. Deleted comments and their replies are not included. There is no pagination, so the response grows with the number of comments on the post. When the request carries a valid session cookie, each comment's \`myReaction\` is the caller's own reaction to it (looked up for the whole thread in one query); otherwise it is null.",
        "operationId": "CommentsController_list",
        "parameters": [
          {
            "in": "path",
            "name": "postId",
            "required": true,
            "schema": {
              "example": "64f1c2e5a1b2c3d4e5f6a7b9",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommentListResponseDto",
                },
              },
            },
            "description": "",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Malformed post id.",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "The post does not exist or has been deleted.",
          },
        },
        "summary": "List a post's comments as a tree",
        "tags": [
          "comments",
        ],
      },
      "post": {
        "description": "Regular (\`user\`-role) accounts only. Creates a top-level comment, or a reply when \`parentCommentId\` is given (omit it, or send null, for top level) — there is no separate reply endpoint. The post comes from the URL and the author is always the authenticated caller; neither is accepted in the body. A reply is accepted at any depth — there is no limit on how many times people may reply to each other; depth only affects how deep the returned tree nests (see GET), never whether a reply is allowed. Increments the post's \`commentCount\`.",
        "operationId": "CommentsController_create",
        "parameters": [
          {
            "in": "path",
            "name": "postId",
            "required": true,
            "schema": {
              "example": "64f1c2e5a1b2c3d4e5f6a7b9",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCommentDto",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommentResponseDto",
                },
              },
            },
            "description": "",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Malformed post id or parentCommentId; a blank, whitespace-only or over-2000-character body; an unknown property in the body; or a parent comment that belongs to a different post.",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Missing, invalid, or expired session cookie.",
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "Administrator accounts cannot create comments (role check: only the \`user\` role may). Admins can still delete any comment.",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto",
                },
              },
            },
            "description": "The post does not exist or has been deleted, or the parent comment does not exist or has been deleted.",
          },
        },
        "security": [
          {
            "access_token": [],
          },
        ],
        "summary": "Create a comment",
        "tags": [
          "comments",
        ],
      },
    },
