MONGODB_URI=
PORT=3000
# development | production | test (blank = development)
NODE_ENV=

# Access token: short-lived (blank = 15m). Refresh token: separate secret, at
# least 32 chars and different from JWT_SECRET (blank expiry = 7d).
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=

# Blank = secure cookies when NODE_ENV=production, plain cookies otherwise.
# false is rejected in production.
COOKIE_SECURE=
# Path the browser sends the refresh cookie to; must cover POST /auth/refresh.
COOKIE_REFRESH_PATH=/auth
FRONTEND_ORIGIN=http://localhost:3001

# AI post summarizer (all optional; without a key the deterministic mock is used)
SUMMARIZER_PROVIDER=
SUMMARIZER_API_KEY=
SUMMARIZER_MODEL=gemini-3.5-flash-lite
SUMMARIZER_TIMEOUT_MS=10000
# Post purge job: hard-deletes posts soft-deleted more than RETENTION_DAYS ago
# (and their comments and reactions). All optional.
POST_PURGE_ENABLED=true
POST_PURGE_RETENTION_DAYS=7
# 5 or 6 fields; default is every day at 03:00 server time.
POST_PURGE_CRON=0 3 * * *

# First admin: read only by `npm run seed:admin` (scripts/seed-admin.ts), and only
# when no admin exists yet. Set them for that one run, then remove them. The
# running app never reads them.
ADMIN_FULLNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Outgoing mail. Locally: Mailpit (docker compose), SMTP on host port 1026.
SMTP_HOST=localhost
SMTP_PORT=1026
MAIL_FROM=DevCommunity <no-reply@devcommunity.local>
# Queue-demo test switches. Leave blank (off) normally; refused in production.
MAIL_FAILURE_RATE=
MAIL_DELAY_MS=