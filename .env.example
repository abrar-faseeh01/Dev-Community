# Each secret must be 32+ characters, and the two must be different.
JWT_SECRET=
JWT_REFRESH_SECRET=
# First admin (used only by the one-off seed service, pass from your shell, do not put in .env):
#   $env:ADMIN_FULLNAME="Admin"; $env:ADMIN_EMAIL="admin@example.com"; $env:ADMIN_PASSWORD="<strong password>"
#   docker compose run --rm --build seed